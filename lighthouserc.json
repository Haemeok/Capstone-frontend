{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/search/results?q=%EA%B9%80%EC%B9%98%EC%B0%8C%EA%B0%9C"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "first-contentful-paint": ["warn", { "maxNumericValue": 5000 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 20000 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 800 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:3000/$",
          "assertions": {
            "categories:seo": ["error", { "minScore": 1 }]
          }
        }
      ]
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
