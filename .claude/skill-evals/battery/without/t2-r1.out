```tsx
import Image from "next/image";

interface RecipeThumbProps {
  src: string;
  alt: string;
  /** true로 주면 LCP 이미지로 간주하고 즉시 로드한다 (목록 상단 첫 카드 등) */
  priority?: boolean;
  className?: string;
}

export default function RecipeThumb({
  src,
  alt,
  priority = false,
  className = "",
}: RecipeThumbProps) {
  return (
    <div
      className={`relative aspect-[4/3] w-full overflow-hidden rounded-lg bg-gray-100 ${className}`}
    >
      <Image
        src={src}
        alt={alt}
        fill
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
        className="object-cover transition-transform duration-300 hover:scale-105"
        priority={priority}
        quality={75}
      />
    </div>
  );
}
```
