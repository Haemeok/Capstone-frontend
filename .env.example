# Google AI Studio — reused for Imagen 4 Fast
GEMINI_STUDIO_API_KEY=

# Server-only admin user ID (NOT NEXT_PUBLIC). Used by admin-guard to gate /admin/* pages,
# Server Actions, and admin API routes. Set the same value in .env.local and Vercel env.
ADMIN_USER_ID=
